# ============================================================
# 只有这几项必须写在文件里。其余全部在网页后台配置（存 DB）。
# 配置读取优先级：DB → .env → 内置默认
# ============================================================

# 加密 DB 内敏感字段（api_hash / api_key / HMAC 密钥）的主密钥。
# 留空则首次启动自动生成到 ./secret.key。
# 换机器时这个值（或 secret.key 文件）必须一起搬，否则已存的密钥解不开。
TGMON_SECRET_KEY=

# 后台登录初始密码。首次启动建账号用，之后改密码就在网页里改。
# 建完账号建议把这行清空。
TGMON_ADMIN_PASSWORD=

# 对外访问地址，用于 RSS 里的绝对链接与 webhook 回调
# 例：https://tgmon.example.com
TGMON_BASE_URL=https://tgmon.example.com

# 反向代理站点（Caddy 容器读取，见 Caddyfile）
# TGMON_DOMAIN：对外域名，与 TGMON_BASE_URL 的主机名保持一致；
#              没有域名时保持 localhost，本地开发默认即可用
# TGMON_IP：可选的 IP 直连回退入口（自签证书），只在需要绕过 DNS 时设置
TGMON_DOMAIN=localhost
TGMON_IP=127.0.0.1

# 日志级别 DEBUG / INFO / WARNING
TGMON_LOG_LEVEL=INFO

# 可选：消息混合检索与 QQ 记忆默认开关（后台也可修改）
TGMON_RETRIEVAL_ENABLED=true
TGMON_EMBEDDING_ENABLED=true
# 模型运行时完全本地；Docker 构建自动准备权重。本地安装先执行：
# python -m tgmon.embeddings --download
# TGMON_EMBEDDING_CACHE=/app/models
TGMON_MEMORY_ENABLED=true
TGMON_MEMORY_TTL_DAYS=30

# Wiki 同步默认配置会自动登记原神、崩铁、绝区零三个 Fandom API 来源
TGMON_WIKI_SYNC_ENABLED=true
TGMON_WIKI_FETCH_INTERVAL_HOURS=24
